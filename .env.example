# The Dermatology Vet: server configuration.
# Copy this file to .env and fill it in. .env is git-ignored: never commit the API key.

# SendGrid API key with "Mail Send" permission.
SENDGRID_API_KEY=

# Sender. Must be a verified Single Sender in SendGrid, or on a domain authenticated
# in SendGrid (Settings > Sender Authentication).
#   Local testing:  MAIL_FROM=ishanit@bytefoundry.ai
#   Production:     MAIL_FROM=hello@thedermatology.vet (after authenticating thedermatology.vet)
MAIL_FROM=
MAIL_FROM_NAME=The Dermatology Vet Website

# Who receives each form. Comma-separate several addresses.
#   Local testing:  all three = ishanit@bytefoundry.ai
#   Production (mailboxes created 18 Nov 2026):
#     MAIL_TO_APPOINTMENT=hello@thedermatology.vet   (Contact page: Request an appointment)
#     MAIL_TO_TELECONSULT=hello@thedermatology.vet   (Services page: Request a Tele-Consult)
#     MAIL_TO_REFERRAL=refer@thedermatology.vet      (TDV Connect: Send a case)
MAIL_TO_APPOINTMENT=
MAIL_TO_TELECONSULT=
MAIL_TO_REFERRAL=

# Server. Use HOST=0.0.0.0 on the hosting server. TRUST_PROXY=1 when behind
# nginx or a load balancer that sets X-Forwarded-For (used for rate limiting).
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=0
